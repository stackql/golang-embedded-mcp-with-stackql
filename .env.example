# Copy to .env and fill in. .env is gitignored. Export it before running
# anything (set -a; . ./.env; set +a): the embedded server and stackql-deploy
# read provider credentials from the process environment.
#
# Zero-credential paths, for people who clone the repo: minimal-sidecar,
# minimal-vendored, every agent's --check, audit-agent-sidecar (github via
# null_auth), sandboxctl-vendored tools, primer/pgwire-go-app, and the
# golden-path stack's dry run.

# ---- GitHub (audit-agent-sidecar, golden-path stack; reads work with no token) ----
# A classic PAT (repo, read:org) or a fine-grained token with Administration:
# write and Issues: write on the target repo. Reads work without it; the
# audit agent switches from null_auth to the token when the password is set.
STACKQL_GITHUB_USERNAME=
STACKQL_GITHUB_PASSWORD=

# The org and repo the audit agent reviews and the golden-path stack manages.
GITHUB_ORG=stackql
GITHUB_REPO=golang-embedded-mcp-with-stackql

# ---- Model (act 3) ----
# Every agent talks to Claude through anthropic-sdk-go.
ANTHROPIC_API_KEY=
# Optional per-agent model overrides (default claude-sonnet-5)
# SRE_AGENT_MODEL=claude-opus-5
# FINOPS_AGENT_MODEL=claude-sonnet-5
# AUDIT_AGENT_MODEL=claude-sonnet-5
# ANTHROPIC_MODEL=claude-sonnet-5          # sandboxctl-vendored

# ---- AWS + Cloudflare (the service-footprint and aws-webserver stacks, sre-agent-sidecar's sweep, finops-agent-vendored's report) ----
# Standard AWS env vars are picked up by the aws and awscc providers.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
# Where the t3.micro goes: a VPC and a subnet that auto-assigns public IPs
# (the default VPC's subnets do), and an Amazon Linux 2023 AMI for the region:
#   aws ec2 describe-images --owners amazon --filters "Name=name,Values=al2023-ami-2023*-x86_64" --query "sort_by(Images,&CreationDate)[-1].ImageId" --output text
AWS_VPC_ID=
AWS_SUBNET_ID=
AWS_AMI_ID=
# Cloudflare: an API token with DNS edit on the zone, and the zone id.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# The service: host.domain is the A record the stack creates and sre-agent-sidecar checks.
DEMO_HOST=golang-demo
DEMO_DOMAIN=stackql.xyz

# ---- Google Cloud (sandboxctl-vendored request / reap) ----
# A service account key JSON, stackql's default google auth.
GOOGLE_CREDENTIALS=

# ---- Embedded server overrides (normally unset; shared with every StackQL wrapper) ----
# Run a stackql binary you already have instead of acquiring one.
# STACKQL_MCP_BIN=/usr/local/bin/stackql
# Extract a local .mcpb instead of downloading (no pin check).
# STACKQL_MCP_BUNDLE=/path/to/stackql-mcp-darwin-universal.mcpb
